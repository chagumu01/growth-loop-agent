# Optional LLM provider configuration. Never commit real secrets.
# `demo` is safe for local preview. For a real model, inject a managed profile
# with llm_config.ps1 so the provider, endpoint, model, and key stay out of source control.
LLM_PROVIDER=demo
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# Fill these only in a deployment secret store after the official account is approved.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
# Learning memory: local persistent SQLite (Node.js >=22.13).
# Keep this path on a persistent volume when deploying.
MEMORY_DB_PATH=.data/memory.sqlite
# Optional OpenAI-compatible embedding service; without it search uses keywords.
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=
